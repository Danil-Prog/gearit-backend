<?xml version="1.0" encoding="UTF-8"?>

<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="11" author="master">

        <createTable tableName="gearit_organization_requests">

            <column name="id" type="BIGSERIAL">
                <constraints primaryKey="true"/>
            </column>

            <column name="full_name" type="VARCHAR">
                <constraints nullable="false"/>
            </column>

            <column name="abbreviated_name" type="VARCHAR">
                <constraints nullable="false"/>
            </column>

            <column name="description" type="VARCHAR">
                <constraints nullable="false"/>
            </column>

            <column name="register_address" type="BIGINT">
                <constraints nullable="false"/>
            </column>

            <column name="current_address" type="BIGINT">
                <constraints nullable="false"/>
            </column>

            <column name="phone_number" type="VARCHAR">
                <constraints nullable="false"/>
            </column>

            <column name="inn" type="VARCHAR">
                <constraints nullable="false"/>
            </column>

            <column name="kpp" type="VARCHAR">
                <constraints nullable="false"/>
            </column>

            <column name="date_creation_organization" type="JAVA.SQL.TYPES.TIMESTAMP_WITH_TIMEZONE">
                <constraints unique="false" nullable="false"/>
            </column>

            <column name="date_creation_request" type="JAVA.SQL.TYPES.TIMESTAMP_WITH_TIMEZONE">
                <constraints unique="false" nullable="false"/>
            </column>

            <column name="owner_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>

            <column name="status" type="VARCHAR">
                <constraints nullable="false" unique="false"/>
            </column>

        </createTable>

        <createTable tableName="gearit_organization_addresses">

            <column name="id" type="BIGSERIAL">
                <constraints primaryKey="true"/>
            </column>

            <column name="index" type="BIGINT">
                <constraints nullable="false" unique="false"/>
            </column>

            <column name="region" type="VARCHAR">
                <constraints nullable="false" unique="false"/>
            </column>

            <column name="city" type="VARCHAR">
                <constraints nullable="false" unique="false"/>
            </column>

            <column name="street" type="VARCHAR">
                <constraints nullable="false" unique="false"/>
            </column>

            <column name="building" type="VARCHAR">
                <constraints nullable="false" unique="false"/>
            </column>

            <column name="placement" type="VARCHAR">
                <constraints nullable="false" unique="false"/>
            </column>

        </createTable>

        <createTable tableName="gearit_comments">

            <column name="id" type="BIGSERIAL">
                <constraints primaryKey="true"/>
            </column>

            <column name="user_provider_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>

            <column name="text" type="VARCHAR(1000)">
                <constraints nullable="false" unique="false"/>
            </column>

        </createTable>

        <createTable tableName="gearit_organization_requests_comments">

            <column name="organization_request_id" type="BIGINT">
                <constraints primaryKey="true" nullable="false"/>
            </column>

            <column name="comment_id" type="BIGINT">
                <constraints primaryKey="true" nullable="false"/>
            </column>

        </createTable>

        <addForeignKeyConstraint baseTableName="gearit_organization_requests"
                                 baseColumnNames="register_address"
                                 constraintName="gearit_organization_requests_register_address_id_fk"
                                 referencedTableName="gearit_organization_addresses"
                                 referencedColumnNames="id"/>

        <addForeignKeyConstraint baseTableName="gearit_organization_requests"
                                 baseColumnNames="current_address"
                                 constraintName="gearit_organization_requests_current_address_id_fk"
                                 referencedTableName="gearit_organization_addresses"
                                 referencedColumnNames="id"/>

        <addForeignKeyConstraint baseTableName="gearit_organization_requests"
                                 baseColumnNames="owner_id"
                                 constraintName="gearit_organization_requests_owner_id_fk"
                                 referencedTableName="gearit_user_provider"
                                 referencedColumnNames="id"/>

        <addForeignKeyConstraint baseTableName="gearit_comments"
                                 baseColumnNames="user_provider_id"
                                 constraintName="gearit_comments_user_provider_id_fk"
                                 referencedTableName="gearit_user_provider"
                                 referencedColumnNames="id"/>

        <addForeignKeyConstraint baseTableName="gearit_organization_requests_comments"
                                 baseColumnNames="organization_request_id"
                                 constraintName="gearit_organization_requests_comments_org_req_id_fk"
                                 referencedTableName="gearit_organization_requests"
                                 referencedColumnNames="id"/>

        <addForeignKeyConstraint baseTableName="gearit_organization_requests_comments"
                                 baseColumnNames="comment_id"
                                 constraintName="gearit_organization_requests_comments_comment_id_fk"
                                 referencedTableName="gearit_comments"
                                 referencedColumnNames="id"/>

    </changeSet>

</databaseChangeLog>