<?xml version="1.0" encoding="UTF-8"?>

<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="2" author="master">

        <createTable tableName="gearit_action_codes">

            <column name="user_provider_id" type="BIGINT">
                <constraints primaryKey="true" nullable="false"/>
            </column>

            <column name="code" type="VARCHAR">
                <constraints unique="false" nullable="false"/>
            </column>

            <column name="expires_at" type="JAVA.SQL.TYPES.TIMESTAMP_WITH_TIMEZONE">
                <constraints unique="false" nullable="false"/>
            </column>

            <column name="action_type" type="VARCHAR">
                <constraints unique="false" nullable="false"/>
            </column>

        </createTable>

        <addForeignKeyConstraint
                baseTableName="gearit_action_codes"
                baseColumnNames="user_provider_id"
                referencedTableName="gearit_user_provider"
                referencedColumnNames="id"
                constraintName="fk_gearit_action_code_user"/>

    </changeSet>

</databaseChangeLog>