<?xml version="1.0" encoding="UTF-8"?>

<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="6" author="master">

        <createTable tableName="gearit_access_policies">

            <column name="id" type="BIGSERIAL">
                <constraints primaryKey="true"/>
            </column>

            <column name="name" type="VARCHAR">
                <constraints unique="false" nullable="false"/>
            </column>

        </createTable>

        <createTable tableName="gearit_access_policies_endpoints">

            <column name="access_policy_id" type="BIGINT">
                <constraints primaryKey="true" nullable="false"/>
            </column>

            <column name="endpoint_id" type="BIGINT">
                <constraints primaryKey="true" nullable="false"/>
            </column>

        </createTable>

        <addForeignKeyConstraint baseTableName="gearit_access_policies_endpoints"
                                 baseColumnNames="access_policy_id"
                                 constraintName="gearit_access_policies_endpoints_access_policies_fk"
                                 referencedTableName="gearit_access_policies"
                                 referencedColumnNames="id"/>

        <addForeignKeyConstraint baseTableName="gearit_access_policies_endpoints"
                                 baseColumnNames="endpoint_id"
                                 constraintName="gearit_access_policies_endpoints_endpoints_fk"
                                 referencedTableName="gearit_endpoints"
                                 referencedColumnNames="id"/>

    </changeSet>

</databaseChangeLog>